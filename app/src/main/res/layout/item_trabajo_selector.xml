<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTrabajo"
    android:layout_width="152dp"
    android:layout_height="132dp"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/industrial_surface_input"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/industrial_border"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivIconoTrabajo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="@drawable/bg_pill_accent"
            android:src="@drawable/ic_task_welding" />

        <TextView
            android:id="@+id/tvNombreTrabajo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/industrial_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Soldadura de Arco" />

        <TextView
            android:id="@+id/tvNorma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/industrial_accent_glow"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="NOM-027" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
